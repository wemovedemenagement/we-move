{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build --configLoader bundle && node scripts/prerender-site.mjs",
    "validate:release": "npm run lint && npm run build && node scripts/check-release.mjs",
    "deploy:crm": "node --use-env-proxy scripts/deploy-crm.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:seo": "node scripts/test-seo.mjs",
    "start": "node server.mjs",
    "test:server": "node scripts/test-server.mjs",
    "test:performance": "node scripts/test-performance.mjs",
    "test:crm": "node scripts/test-crm.mjs",
    "test:crm:tarification": "node scripts/test-crm-pricing.mjs",
    "test:crm:devis": "node scripts/test-crm-drafts.mjs",
    "test:crm:suivi": "node scripts/test-crm-follow-up.mjs",
    "test:crm:factures": "node scripts/test-crm-invoices.mjs",
    "test:crm:workspace": "node scripts/test-crm-workspace.mjs",
    "test:crm:facturation-test": "node scripts/test-crm-test-billing.mjs",
    "test:crm:facturation": "node scripts/test-crm-billing.mjs",
    "test:crm:encaissements": "node scripts/test-crm-billing-overview.mjs",
    "test:crm:relances-factures": "node scripts/test-crm-billing-reminder.mjs",
    "test:crm:exports": "node scripts/test-crm-billing-export.mjs",
    "test:crm:recherche-factures": "node scripts/test-crm-billing-search.mjs",
    "test:crm:suivi-devis": "node scripts/test-crm-quote-follow-up.mjs",
    "test:crm:visites": "node scripts/test-crm-visits.mjs",
    "test:crm:recherche": "node scripts/test-crm-search.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/secret-manager": "^7.1.0",
    "@google-cloud/storage": "^8.4.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase-tools": "15.31.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
