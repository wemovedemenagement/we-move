# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Clé navigateur Google Maps : Maps JavaScript API + Places API (New).
# Restreindre la clé aux référents HTTP du site et aux deux API nécessaires.
VITE_GOOGLE_MAPS_API_KEY=""

# Origine canonique publique du site (sans chemin ni slash final).
VITE_SITE_URL="https://we-move.fr"

# Serveur CRM — ne jamais préfixer ces variables par VITE_.
CRM_STORAGE=firestore
# Activer seulement après validation de la reprise PARC et de la date de bascule.
CRM_BILLING_LIVE_ENABLED=false
FIREBASE_PROJECT_ID=wemove-b0057
FIRESTORE_DATABASE_ID=(default)
# Développement local uniquement, compte déjà connecté par firebase login.
# CRM_FIREBASE_CLI_ACCOUNT=compte-google@example.com
# CRM_LOCAL_ACCESS=true
# En hébergement : ADC et IAM du compte de service, sans session CLI.

# Envoi de devis : secrets serveur uniquement (jamais VITE_ ni dans Git).
CRM_MAIL_PROVIDER="resend"
CRM_MAIL_FROM="contact@we-move.fr"
# Référence publique d’un secret, pas sa valeur. Version à adapter après création.
CRM_MAIL_API_KEY_SECRET="projects/wemove-b0057/secrets/we-move-mail-sending-key/versions/1"
